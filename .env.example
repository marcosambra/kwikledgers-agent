# KwikLedgers Dev Agent - Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# --- Azure DevOps ---
# URL da organizacao
AZURE_ORG_URL=https://dev.azure.com/viwaredevop

# Personal Access Token - gere em: https://dev.azure.com/viwaredevop/_usersSettings/tokens
# Permissoes necessarias: Work Items (Read & Write), Code (Read), Pull Requests (Read & Write)
AZURE_PAT=seu_personal_access_token_aqui

# Nome do projeto no Azure DevOps
AZURE_PROJECT=Kwik Ledgers

# --- Postman ---
# API Key - gere em: app.postman.com > Settings > API Keys
POSTMAN_API_KEY=sua_postman_api_key_aqui
