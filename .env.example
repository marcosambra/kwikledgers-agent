# KwikLedgers Dev Agent - Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# --- Azure DevOps ---
# URL da organizacao
AZURE_ORG_URL=https://dev.azure.com/viwaredevops

# Personal Access Token - gere em: https://dev.azure.com/viwaredevops/_usersSettings/tokens
# Permissoes necessarias: Work Items (Read & Write), Code (Read), Pull Requests (Read & Write)
AZURE_PAT=seu_personal_access_token_aqui

# Email do usuario no Azure DevOps. Se vazio, o agente tenta usar git config user.email.
AZURE_USER_EMAIL=

# Nome do projeto no Azure DevOps
AZURE_PROJECT=Kwik Ledgers

# Time opcional do Azure DevOps. Se vazio, o agente tenta escolher o time com
# sprint ativa no ano atual.
AZURE_TEAM=Squad Portal Market Place
