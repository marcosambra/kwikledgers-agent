{
  "mcpServers": {
    "kwikledgers-azure-devops": {
      "command": "bash",
      "args": ["${workspaceFolder}/agent/mcp_servers/azure_devops/run.sh"]
    },
    "postman": {
      "command": "npx",
      "args": ["-y", "@postman/mcp-server"],
      "env": {
        "POSTMAN_API_KEY": "${env:POSTMAN_API_KEY}"
      }
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
    },
    "kwikledgers-windows": {
      "command": "bash",
      "args": ["${workspaceFolder}/agent/mcp_servers/windows_calendar/run.sh"]
    }
  }
}
