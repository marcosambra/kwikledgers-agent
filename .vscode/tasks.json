{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KwikLedgers Agent: Setup",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "if [ ! -f '${workspaceFolder}/.env' ]; then bash '${workspaceFolder}/setup.sh'; else echo 'Setup ja realizado. .env encontrado.'; fi"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
